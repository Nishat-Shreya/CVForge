<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.cvforge">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 13 and newer ask the user before notifications can be shown -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Exact times for interview reminders. From Android 12 the user allows it in the settings. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- To set the reminder alarms again after the phone restarts -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Put an interview in the phone calendar. The app asks the user at runtime. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- Interview coach: the student can speak the answer. Asked at runtime. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 11+: lets the app find the speech recognition service -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".CvForgeApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CVForge"
        tools:targetApi="31">
        <activity
            android:name=".ui.post.ApplicantsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.post.ApplicantCvActivity"
            android:exported="false" />
        <activity
            android:name=".ui.tracker.ApplicationDetailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.discover.BookmarksActivity"
            android:exported="false" />
        <activity
            android:name=".ui.discover.InternshipDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.discover.RoadmapActivity"
            android:exported="false" />
        <activity
            android:name=".ui.profile.RequestEndorsementActivity"
            android:exported="false" />
        <activity
            android:name=".ui.teacher.EndorseActivity"
            android:exported="false" />
        <activity
            android:name=".ui.alumni.SlotsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.profile.BookSlotActivity"
            android:exported="false" />
        <activity
            android:name=".ui.coach.CoachActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.chat.ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.chat.ChatsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.post.MyPostsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.post.PostInternshipActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.cv.GithubImportActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.cv.CvEditorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.student.StudentActivity"
            android:exported="false" />
        <activity
            android:name=".ui.admin.AdminActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.PendingActivity"
            android:exported="false" />
        <activity
            android:name=".ui.company.CompanyActivity"
            android:exported="false" />
        <activity
            android:name=".ui.teacher.TeacherActivity"
            android:exported="false" />
        <activity
            android:name=".ui.alumni.AlumniActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.SignUpActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.WelcomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".receiver.ReminderReceiver"
            android:exported="false" />

        <service
            android:name=".service.CvForgeMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Push messages that arrive while the app is closed use this channel and icon -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="cvforge_updates" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />

        <service
            android:name=".service.JobSyncService"
            android:exported="false" />

        <provider
            android:name=".provider.CvProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>

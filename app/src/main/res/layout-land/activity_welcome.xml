<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape Welcome screen: the same content at a fixed height inside a ScrollView.
     Scrolling is fine here because there is not enough height. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/violet"
    tools:context=".ui.auth.WelcomeActivity">

    <include
        android:id="@+id/content"
        layout="@layout/content_welcome"
        android:layout_width="match_parent"
        android:layout_height="640dp" />
</ScrollView>

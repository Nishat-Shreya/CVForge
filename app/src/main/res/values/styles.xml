<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Text styles: Sora for headings and numbers, DM Sans for body -->
    <style name="TextScreenTitle">
        <item name="android:fontFamily">@font/sora</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextSectionTitle">
        <item name="android:fontFamily">@font/sora</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextBigNumber">
        <item name="android:fontFamily">@font/sora</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextCardTitle">
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextBody">
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextMuted" parent="TextBody">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/muted</item>
    </style>

    <!-- Chips: tint background with its dark text color -->
    <style name="ChipTint">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:minHeight">28dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:backgroundTint">@color/violet_tint</item>
        <item name="android:textColor">@color/violet_text</item>
    </style>
    <style name="ChipTint.Violet" />
    <style name="ChipTint.Coral">
        <item name="android:backgroundTint">@color/coral_tint</item>
        <item name="android:textColor">@color/coral_text</item>
    </style>
    <style name="ChipTint.Teal">
        <item name="android:backgroundTint">@color/teal_tint</item>
        <item name="android:textColor">@color/teal_text</item>
    </style>
    <style name="ChipTint.Amber">
        <item name="android:backgroundTint">@color/amber_tint</item>
        <item name="android:textColor">@color/amber_text</item>
    </style>
    <style name="ChipTint.Sky">
        <item name="android:backgroundTint">@color/sky_tint</item>
        <item name="android:textColor">@color/sky_text</item>
    </style>

    <!-- Buttons: fully rounded, press animation from res/animator/press_scale.xml -->
    <style name="ButtonBase" parent="Widget.MaterialComponents.Button">
        <item name="android:fontFamily">@font/sora</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
        <item name="cornerRadius">26dp</item>
    </style>

    <style name="ButtonPrimary" parent="ButtonBase">
        <item name="android:minHeight">@dimen/button_height_main</item>
        <item name="backgroundTint">@color/violet</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="ButtonDark" parent="ButtonBase">
        <item name="android:minHeight">@dimen/button_height_main</item>
        <item name="backgroundTint">@color/ink</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="ButtonOutline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:fontFamily">@font/sora</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">@dimen/button_height_main</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
        <item name="android:textColor">@color/ink</item>
        <item name="cornerRadius">26dp</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Selectable role chip (Student, Company, ...): violet when checked -->
    <style name="TextAppearance.RoleChip" parent="TextAppearance.MaterialComponents.Chip">
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="RoleChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="android:textAppearance">@style/TextAppearance.RoleChip</item>
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="chipMinHeight">44dp</item>
        <item name="chipStrokeColor">@color/border</item>
        <item name="chipStrokeWidth">1.5dp</item>
        <item name="chipCornerRadius">22dp</item>
        <item name="chipStartPadding">8dp</item>
        <item name="chipEndPadding">8dp</item>
        <item name="textStartPadding">2dp</item>
        <item name="textEndPadding">2dp</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <!-- Text field: white box with rounded corners -->
    <style name="InputBox" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/violet</item>
        <item name="hintTextColor">@color/violet_text</item>
        <item name="boxBackgroundColor">@color/card</item>
    </style>

    <!-- Cards: white, 1dp border, 20dp corners -->
    <style name="CardBase" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/card</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">@dimen/card_stroke</item>
    </style>

    <!-- Round white icon button, 44dp -->
    <style name="IconCircleButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:minWidth">@dimen/icon_button_size</item>
        <item name="android:minHeight">@dimen/icon_button_size</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
        <item name="backgroundTint">@color/card</item>
        <item name="iconTint">@color/ink</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="cornerRadius">22dp</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
    </style>

</resources>

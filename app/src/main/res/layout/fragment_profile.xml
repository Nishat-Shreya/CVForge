<?xml version="1.0" encoding="utf-8"?>
<!-- Profile tab, matches Docs/07-profile.png -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/screen_padding">

        <!-- Teal header with three decoration circles and the edit button -->
        <FrameLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="@color/teal"
            android:clipChildren="true">

            <com.example.cvforge.ui.view.CircleDecorationView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:circleCenterX="1"
                app:circleCenterY="0"
                app:circleColor="@color/violet"
                app:circleRadius="100dp" />

            <com.example.cvforge.ui.view.CircleDecorationView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:circleCenterX="0.2"
                app:circleCenterY="1"
                app:circleColor="@color/amber"
                app:circleRadius="60dp" />

            <com.example.cvforge.ui.view.CircleDecorationView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:circleCenterX="0.55"
                app:circleCenterY="0.3"
                app:circleColor="@color/coral"
                app:circleRadius="18dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEdit"
                style="@style/IconCircleButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="top|end"
                android:layout_margin="@dimen/screen_padding"
                android:backgroundTint="@color/white"
                android:contentDescription="@string/profile_edit"
                app:icon="@drawable/ic_edit"
                app:iconTint="@color/ink"
                app:strokeWidth="0dp" />
        </FrameLayout>

        <!-- Avatar overlaps the header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-38dp"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/screen_padding">

            <TextView
                android:id="@+id/textInitials"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_avatar"
                android:backgroundTint="@color/coral"
                android:contentDescription="@string/change_photo"
                android:fontFamily="@font/sora"
                android:gravity="center"
                android:textColor="@color/ink"
                android:textSize="26sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="44dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textName"
                    style="@style/TextScreenTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/textMeta"
                    style="@style/TextMuted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding">

            <!-- Stats card: Endorsements teal, Badges violet, Streak coral -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStats"
                style="@style/CardBase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textStatEndorsements"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/sora"
                            android:text="0"
                            android:textColor="@color/teal_text"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/TextMuted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stat_endorsements" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textStatBadges"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/sora"
                            android:text="0"
                            android:textColor="@color/violet_text"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/TextMuted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stat_badges" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textStatStreak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/sora"
                            android:text="0"
                            android:textColor="@color/coral_text"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/TextMuted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stat_streak" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Round badges -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/rowBadges"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                style="@style/TextSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/endorsements_title" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listEndorsements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/textNoEndorsements"
                style="@style/TextMuted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/endorsements_none"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRequestEndorsement"
                style="@style/ButtonOutline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/endorsements_request" />

            <!-- The next open mentor slot -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSlot"
                style="@style/CardBase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/coral_tint">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/textSlotInitials"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_avatar"
                        android:backgroundTint="@color/coral"
                        android:fontFamily="@font/sora"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:textColor="@color/ink"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textSlotTitle"
                            style="@style/TextCardTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/textSlotTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/dm_sans"
                            android:textColor="@color/coral_text"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBookSlot"
                        style="@style/ButtonDark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/slot_book" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBookMentor"
                style="@style/ButtonOutline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/slots_book_open" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/ButtonOutline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/log_out" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

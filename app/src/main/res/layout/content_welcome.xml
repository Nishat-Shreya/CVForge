<?xml version="1.0" encoding="utf-8"?>
<!-- Welcome content, matches Docs/01-welcome.png. It never scrolls: the violet top part
     takes the free height and the white sheet only takes what it needs. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/contentRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/violet">

    <!-- Decorative circles, sized from the violet top part -->
    <com.example.cvforge.ui.view.CircleDecorationView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:circleCenterX="0.95"
        app:circleCenterY="0.02"
        app:circleColor="@color/coral"
        app:circleRadius="150dp"
        app:layout_constraintBottom_toTopOf="@id/sheet"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.cvforge.ui.view.CircleDecorationView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:circleCenterX="0.76"
        app:circleCenterY="0.2"
        app:circleColor="@color/teal"
        app:circleRadius="32dp"
        app:layout_constraintBottom_toTopOf="@id/sheet"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.cvforge.ui.view.CircleDecorationView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:circleCenterX="0"
        app:circleCenterY="0.4"
        app:circleColor="@color/amber"
        app:circleRadius="70dp"
        app:layout_constraintBottom_toTopOf="@id/sheet"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Logo -->
    <LinearLayout
        android:id="@+id/logoRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_chip"
            android:backgroundTint="@color/amber"
            android:fontFamily="@font/sora"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:text="@string/logo_cv"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/sora"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- The floating cards sit in the free space between the logo and the headline -->
    <LinearLayout
        android:id="@+id/cardsColumn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center_vertical"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/headlineBlock"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logoRow">

        <include
            android:id="@+id/cardMatch"
            layout="@layout/include_welcome_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp" />

        <include
            android:id="@+id/cardInterview"
            layout="@layout/include_welcome_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="16dp" />

        <include
            android:id="@+id/cardVerified"
            layout="@layout/include_welcome_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Headline -->
    <LinearLayout
        android:id="@+id/headlineBlock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/sheet"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/textHeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sora"
            android:maxLines="2"
            android:text="@string/welcome_headline"
            android:textColor="@color/white"
            android:textSize="30sp"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="30sp"
            app:autoSizeMinTextSize="22sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform" />

        <TextView
            android:id="@+id/textSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0.85"
            android:text="@string/welcome_subtitle"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- White bottom sheet, only as tall as its content -->
    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sheet_top"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="20dp"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/screen_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            style="@style/TextMuted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/i_am_a"
            android:textStyle="bold" />

        <!-- One row, no wrapping -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/groupRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:chipSpacingHorizontal="6dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipStudent"
                style="@style/RoleChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:tag="student"
                android:text="@string/role_student"
                android:textSize="13sp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCompany"
                style="@style/RoleChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="company"
                android:text="@string/role_company"
                android:textSize="13sp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTeacher"
                style="@style/RoleChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="teacher"
                android:text="@string/role_teacher"
                android:textSize="13sp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAlumni"
                style="@style/RoleChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="alumni"
                android:text="@string/role_alumni"
                android:textSize="13sp" />
        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoogle"
            style="@style/ButtonOutline"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="@string/continue_with_google"
            app:icon="@drawable/ic_google"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconSize="24dp"
            app:iconTint="@null" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEmailSignUp"
            style="@style/ButtonDark"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="@string/sign_up_with_email"
            app:icon="@drawable/ic_mail"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@color/white" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                style="@style/TextMuted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/already_have_account" />

            <TextView
                android:id="@+id/textLogIn"
                style="@style/TextCardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:minHeight="44dp"
                android:paddingHorizontal="4dp"
                android:text="@string/log_in"
                android:textColor="@color/violet_text" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Alumni dashboard shell. Opportunities, endorsements and mentor slots come in later checkpoints. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding"
    tools:context=".ui.alumni.AlumniActivity">

    <FrameLayout
        android:id="@+id/heroCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hero_violet"
        android:clipChildren="true"
        android:clipToOutline="true">

        <com.example.cvforge.ui.view.CircleDecorationView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:circleCenterX="1"
            app:circleCenterY="0"
            app:circleColor="@color/coral"
            app:circleRadius="50dp" />

        <com.example.cvforge.ui.view.CircleDecorationView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:circleCenterX="0.7"
            app:circleCenterY="1"
            app:circleColor="@color/amber"
            app:circleRadius="34dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/textGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sora"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/alumni_subtitle"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPost"
        style="@style/ButtonPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/post_internship" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogout"
        style="@style/ButtonOutline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/log_out" />
</LinearLayout>

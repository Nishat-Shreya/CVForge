<?xml version="1.0" encoding="utf-8"?>
<!-- Chat screen, matches Docs/06-chat.png. No bottom navigation. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.chat.ChatActivity">

    <!-- Top bar: back, avatar, name and the Verified chip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingVertical="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/IconCircleButton"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:contentDescription="@string/back"
            app:icon="@drawable/ic_arrow_back"
            app:iconTint="@color/ink" />

        <TextView
            android:id="@+id/textInitials"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_avatar"
            android:backgroundTint="@color/violet"
            android:fontFamily="@font/sora"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textName"
                style="@style/TextCardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/chipVerified"
                style="@style/ChipTint.Teal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/endorsement_verified"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- What this chat is about -->
    <TextView
        android:id="@+id/textBanner"
        style="@style/ChipTint.Amber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/amber_tint"
        android:drawableStart="@drawable/ic_calendar"
        android:drawablePadding="10dp"
        android:drawableTint="@color/amber_text"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:paddingHorizontal="@dimen/screen_padding"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/textError"
        style="@style/TextMuted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="8dp"
        android:visibility="gone" />

    <!-- Typing dots of the other person -->
    <LinearLayout
        android:id="@+id/typingDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_bubble_received"
        android:contentDescription="@string/chat_typing"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:visibility="gone">

        <View
            android:id="@+id/dot1"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_avatar"
            android:backgroundTint="@color/muted" />

        <View
            android:id="@+id/dot2"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_avatar"
            android:backgroundTint="@color/muted" />

        <View
            android:id="@+id/dot3"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_avatar"
            android:backgroundTint="@color/muted" />
    </LinearLayout>

    <!-- Quick replies -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/groupQuick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/screen_padding"
            app:chipSpacingHorizontal="8dp"
            app:singleLine="true" />
    </HorizontalScrollView>

    <!-- Input bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <EditText
            android:id="@+id/editMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input_pill"
            android:fontFamily="@font/dm_sans"
            android:hint="@string/chat_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:minHeight="52dp"
            android:paddingHorizontal="18dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_avatar"
            android:backgroundTint="@color/violet"
            android:contentDescription="@string/chat_send"
            android:src="@drawable/ic_send" />
    </LinearLayout>
</LinearLayout>

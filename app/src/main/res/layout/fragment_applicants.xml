<?xml version="1.0" encoding="utf-8"?>
<!-- Applicants of a poster, matches Docs/08-company-applicants.png -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/rowTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingTop="16dp">

        <TextView
            style="@style/TextScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tab_applicants" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChat"
            style="@style/IconCircleButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/open_chat"
            app:icon="@drawable/ic_chat" />
    </LinearLayout>

    <!-- Job selector -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnJob"
        style="@style/ButtonDark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_padding"
        android:layout_marginTop="12dp"
        android:gravity="start|center_vertical"
        android:text="@string/select_internship"
        app:icon="@drawable/ic_chevron_down"
        app:iconGravity="end"
        app:iconTint="@color/white" />

    <!-- Tabs: New, Shortlisted, Interview -->
    <LinearLayout
        android:id="@+id/rowTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_padding"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tabNew"
            style="@style/ChipTint"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="18dp"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tabShortlisted"
            style="@style/ChipTint"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="18dp"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tabInterview"
            style="@style/ChipTint"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="18dp"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listApplicants"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/screen_padding" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/violet" />

        <include
            android:id="@+id/empty"
            layout="@layout/include_empty_state"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>

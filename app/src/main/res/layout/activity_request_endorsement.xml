<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.profile.RequestEndorsementActivity">

    <include
        android:id="@+id/toolbar"
        layout="@layout/include_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingBottom="@dimen/screen_padding">

            <TextView
                style="@style/TextMuted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/request_intro" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickSkill"
                style="@style/ButtonOutline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/request_pick_skill" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickEndorser"
                style="@style/ButtonOutline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/request_pick_endorser" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSend"
                style="@style/ButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/request_send" />

            <TextView
                style="@style/TextSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/request_my_requests" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listRequests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/textNoRequests"
                style="@style/TextMuted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/request_none"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>

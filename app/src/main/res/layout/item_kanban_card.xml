<?xml version="1.0" encoding="utf-8"?>
<!-- One application card on the Kanban board, with a colored top border -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/CardBase"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:id="@+id/viewTopBorder"
            android:layout_width="match_parent"
            android:layout_height="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/textTitle"
                style="@style/TextCardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sora"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textCompany"
                style="@style/TextMuted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Status chips: Shortlisted, Rejected, No reply, Closes in. They always have text. -->
            <LinearLayout
                android:id="@+id/rowChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

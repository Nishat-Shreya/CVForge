<?xml version="1.0" encoding="utf-8"?>
<!-- CV Builder, matches Docs/04-cv-builder.png. The strength card, Export PDF, versions and the
     other buttons are added in later checkpoints. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingHorizontal="@dimen/screen_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/screen_padding">

        <TextView
            android:id="@+id/textTitle"
            style="@style/TextScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:paddingTop="16dp"
            android:text="@string/screen_cv_builder" />

        <!-- Template pills -->
        <LinearLayout
            android:id="@+id/rowTemplates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pillModern"
                style="@style/ChipTint"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:paddingHorizontal="20dp"
                android:text="@string/template_modern"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/pillClassic"
                style="@style/ChipTint"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="20dp"
                android:text="@string/template_classic"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/pillMinimal"
                style="@style/ChipTint"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="20dp"
                android:text="@string/template_minimal"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Live preview -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPreview"
            style="@style/CardBase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="20dp">

            <com.example.cvforge.ui.cv.CvPreviewView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditCv"
            style="@style/ButtonPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:text="@string/edit_cv" />
    </LinearLayout>
</ScrollView>

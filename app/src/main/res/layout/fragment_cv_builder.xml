<?xml version="1.0" encoding="utf-8"?>
<!-- CV Builder. A temporary Edit CV button opens the editor, the real screen comes in later checkpoints. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <TextView
        android:id="@+id/textTitle"
        style="@style/TextScreenTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/screen_cv_builder" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEditCv"
        style="@style/ButtonPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/edit_cv" />
</LinearLayout>

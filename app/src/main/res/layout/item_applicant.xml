<?xml version="1.0" encoding="utf-8"?>
<!-- One applicant card, matches Docs/08-company-applicants.png -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/CardBase"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/card_gap"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Match ring: teal 90 and up, sky 80 and up, amber below -->
            <com.example.cvforge.ui.view.ProfileStrengthRing
                android:id="@+id/ringMatch"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@string/match_label"
                app:ringShowPercentSign="false"
                app:ringStrokeWidth="5dp"
                app:ringTextColor="@color/ink"
                app:ringTextSize="14sp"
                app:ringTrackColor="@color/violet_tint" />

            <include
                android:id="@+id/avatar"
                layout="@layout/include_avatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textName"
                    style="@style/TextCardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sora"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/textSchool"
                    style="@style/TextMuted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/groupSkills"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:chipSpacingHorizontal="6dp"
            app:chipSpacingVertical="4dp" />

        <LinearLayout
            android:id="@+id/rowActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrimary"
                style="@style/ButtonBase"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="52dp"
                android:textColor="@color/ink" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReject"
                style="@style/ButtonOutline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/reject"
                android:textColor="@color/coral_text"
                app:strokeColor="@color/coral" />

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
